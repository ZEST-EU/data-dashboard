# --- ZEST Dashboard configuration -------------------------------------------
# Copy to `.env` and adjust. All values are read by vite.config.js at dev/build
# time (they configure the same-origin proxy, so they are NOT exposed to the
# browser). Restart `npm run dev` after changing them.

# Orion-LD Context Broker (NGSI-LD) — source of the DeviceMeasurement entity list.
VITE_ORION_URL=http://localhost:1026

# FIWARE tenant for Orion reads.
#   opcua_biopc  -> the BioPC OPC-UA feed (default)
#   (empty)      -> the zest-cloud mock data in the default tenant
# To target the mock feed, set this to an empty value:  VITE_ORION_TENANT=
VITE_ORION_TENANT=opcua_biopc

# QuantumLeap (NGSI-v2) — source of the time-series history.
VITE_QL_URL=http://localhost:8668

# NGSI-LD @context used for the Orion `Link` header. Rarely needs changing.
VITE_NGSILD_CONTEXT=https://raw.githubusercontent.com/smart-data-models/dataModel.Device/master/context.jsonld
